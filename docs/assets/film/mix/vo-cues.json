 "subtitles": [
  {
   "vo": "VO-01",
   "line": 1,
   "start": 6.091,
   "end": 11.313,
   "text": "剪纸的时候 刀留下线条 叫阳刻"
  },
  {
   "vo": "VO-02",
   "line": 1,
   "start": 14.683,
   "end": 18.081,
   "text": "刀刻去线条 叫阴刻"
  },
  {
   "vo": "VO-03",
   "line": 1,
   "start": 18.985,
   "end": 22.145,
   "text": "丰宁的剪纸 以阳刻为主"
  },
  {
   "vo": "VO-03",
   "line": 2,
   "start": 22.145,
   "end": 25.565,
   "text": "蔚县的剪纸 以阴刻为主"
  },
  {
   "vo": "VO-03",
   "line": 3,
   "start": 25.565,
   "end": 30.163,
   "text": "一刀之差 是两个地方的手艺"
  },
  {
   "vo": "VO-04",
   "line": 1,
   "start": 30.85,
   "end": 33.67,
   "text": "如今 人们常常先从网上"
  },
  {
   "vo": "VO-04",
   "line": 2,
   "start": 33.67,
   "end": 36.534,
   "text": "从 AI 那里认识一个地方"
  },
  {
   "vo": "VO-04",
   "line": 3,
   "start": 36.534,
   "end": 39.014,
   "text": "如果这一刀讲反了"
  },
  {
   "vo": "VO-04",
   "line": 4,
   "start": 39.014,
   "end": 42.73,
   "text": "错的就不只是一个字"
  },
  {
   "vo": "VO-05",
   "line": 1,
   "start": 47.089,
   "end": 48.859,
   "text": "乡艺有据"
  },
  {
   "vo": "VO-05",
   "line": 2,
   "start": 48.859,
   "end": 55.755,
   "text": "每一句讲解有出处 每一分钱有去处"
  },
  {
   "vo": "VO-06",
   "line": 1,
   "start": 56.417,
   "end": 59.413,
   "text": "这是一段准备给游客的讲解词"
  },
  {
   "vo": "VO-06",
   "line": 2,
   "start": 59.413,
   "end": 64.717,
   "text": "我们先把每一句 送回出处去对一对"
  },
  {
   "vo": "VO-07",
   "line": 1,
   "start": 69.817,
   "end": 71.357,
   "text": "资料说得清楚"
  },
  {
   "vo": "VO-07",
   "line": 2,
   "start": 71.357,
   "end": 74.057,
   "text": "阳刻为主 讲的是丰宁"
  },
  {
   "vo": "VO-07",
   "line": 3,
   "start": 74.057,
   "end": 76.517,
   "text": "蔚县 以阴刻为主"
  },
  {
   "vo": "VO-07",
   "line": 4,
   "start": 76.517,
   "end": 83.677,
   "text": "原文 出处 位置 都摆在这里"
  },
  {
   "vo": "VO-08",
   "line": 1,
   "start": 84.202,
   "end": 88.397,
   "text": "至于“每天开放 无需预约”这样的承诺"
  },
  {
   "vo": "VO-08",
   "line": 2,
   "start": 88.397,
   "end": 90.258,
   "text": "资料证明不了"
  },
  {
   "vo": "VO-08",
   "line": 3,
   "start": 90.258,
   "end": 94.702,
   "text": "它不替人答应 留给接待方确认"
  },
  {
   "vo": "VO-09",
   "line": 1,
   "start": 95.641,
   "end": 96.99,
   "text": "如果客人说"
  },
  {
   "vo": "VO-09",
   "line": 2,
   "start": 96.99,
   "end": 100.433,
   "text": "不要茶歇 多留点手作时间"
  },
  {
   "vo": "VO-10",
   "line": 1,
   "start": 102.233,
   "end": 105.713,
   "text": "一句话 整场活动重新排"
  },
  {
   "vo": "VO-10",
   "line": 2,
   "start": 105.713,
   "end": 106.993,
   "text": "茶歇撤下"
  },
  {
   "vo": "VO-10",
   "line": 3,
   "start": 106.993,
   "end": 113.223,
   "text": "手作从 50 分钟 变成 80 分钟"
  },
  {
   "vo": "VO-11",
   "line": 1,
   "start": 113.775,
   "end": 115.879,
   "text": "账也一起重算"
  },
  {
   "vo": "VO-11",
   "line": 2,
   "start": 115.879,
   "end": 119.659,
   "text": "这 796 元里 524 元"
  },
  {
   "vo": "VO-11",
   "line": 3,
   "start": 119.659,
   "end": 124.499,
   "text": "是付给本地讲解和手作老师的报酬"
  },
  {
   "vo": "VO-12",
   "line": 1,
   "start": 126.167,
   "end": 127.447,
   "text": "做不到的事"
  },
  {
   "vo": "VO-12",
   "line": 2,
   "start": 127.447,
   "end": 130.723,
   "text": "比如临时加一场英语讲解"
  },
  {
   "vo": "VO-12",
   "line": 3,
   "start": 130.723,
   "end": 134.185,
   "text": "它会停下来 先问人"
  },
  {
   "vo": "VO-13",
   "line": 1,
   "start": 135.537,
   "end": 138.883,
   "text": "作品 是手艺人的"
  },
  {
   "vo": "VO-14",
   "line": 1,
   "start": 139.925,
   "end": 143.433,
   "text": "他说不用了 旧手册立刻作废"
  },
  {
   "vo": "VO-15",
   "line": 1,
   "start": 145.139,
   "end": 149.619,
   "text": "重新核验 经人确认 才有新的一版"
  },
  {
   "vo": "VO-15",
   "line": 2,
   "start": 149.619,
   "end": 154.425,
   "text": "拍板的 始终是人"
  },
  {
   "vo": "VO-16",
   "line": 1,
   "start": 154.983,
   "end": 158.223,
   "text": "这一切 装在一台普通电脑里"
  },
  {
   "vo": "VO-16",
   "line": 2,
   "start": 158.223,
   "end": 162.483,
   "text": "离线运行 不花一分钱模型调用费"
  },
  {
   "vo": "VO-17",
   "line": 1,
   "start": 163.525,
   "end": 165.165,
   "text": "AI 正在成为人们"
  },
  {
   "vo": "VO-17",
   "line": 2,
   "start": 165.165,
   "end": 168.286,
   "text": "认识一个地方的第一扇窗"
  },
  {
   "vo": "VO-17",
   "line": 3,
   "start": 168.286,
   "end": 171.225,
   "text": "我们让它只讲有出处的话"
  },
  {
   "vo": "VO-17",
   "line": 4,
   "start": 171.225,
   "end": 177.265,
   "text": "把拍板权和收益 留在乡里"
  }
 ],
