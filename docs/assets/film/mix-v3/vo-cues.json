 "subtitles": [
  {
   "vo": "VO-01",
   "line": 1,
   "start": 6.121,
   "end": 10.973,
   "text": "剪纸的时候 刀留下线条 叫阳刻"
  },
  {
   "vo": "VO-02",
   "line": 1,
   "start": 14.683,
   "end": 18.041,
   "text": "刀刻去线条 叫阴刻"
  },
  {
   "vo": "VO-03",
   "line": 1,
   "start": 18.983,
   "end": 22.627,
   "text": "丰宁的剪纸 以阳刻为主"
  },
  {
   "vo": "VO-03",
   "line": 2,
   "start": 22.627,
   "end": 26.691,
   "text": "蔚县的剪纸 以阴刻为主"
  },
  {
   "vo": "VO-03",
   "line": 3,
   "start": 26.691,
   "end": 30.891,
   "text": "一刀之差 是两个地方的手艺"
  },
  {
   "vo": "VO-04",
   "line": 1,
   "start": 31.6,
   "end": 34.982,
   "text": "如今 人们常常先从网上"
  },
  {
   "vo": "VO-04",
   "line": 2,
   "start": 34.982,
   "end": 38.148,
   "text": "从 AI 那里认识一个地方"
  },
  {
   "vo": "VO-04",
   "line": 3,
   "start": 38.148,
   "end": 40.912,
   "text": "如果这一刀讲反了"
  },
  {
   "vo": "VO-04",
   "line": 4,
   "start": 40.912,
   "end": 43.826,
   "text": "错的就不只是一个字"
  },
  {
   "vo": "VO-05",
   "line": 1,
   "start": 52.435,
   "end": 54.053,
   "text": "乡艺有据"
  },
  {
   "vo": "VO-05",
   "line": 2,
   "start": 54.053,
   "end": 59.447,
   "text": "每一句讲解有出处 每一分钱有去处"
  },
  {
   "vo": "VO-06",
   "line": 1,
   "start": 60.683,
   "end": 64.131,
   "text": "这是一段准备给游客的讲解词"
  },
  {
   "vo": "VO-06",
   "line": 2,
   "start": 64.131,
   "end": 68.777,
   "text": "我们先把每一句 送回出处去对一对"
  },
  {
   "vo": "VO-07",
   "line": 1,
   "start": 73.876,
   "end": 75.734,
   "text": "资料说得清楚"
  },
  {
   "vo": "VO-07",
   "line": 2,
   "start": 75.734,
   "end": 79.184,
   "text": "阳刻为主 讲的是丰宁"
  },
  {
   "vo": "VO-07",
   "line": 3,
   "start": 79.184,
   "end": 82.404,
   "text": "蔚县 以阴刻为主"
  },
  {
   "vo": "VO-07",
   "line": 4,
   "start": 82.404,
   "end": 86.818,
   "text": "原文 出处 位置 都摆在这里"
  },
  {
   "vo": "VO-08",
   "line": 1,
   "start": 87.331,
   "end": 91.823,
   "text": "至于“每天开放 无需预约”这样的承诺"
  },
  {
   "vo": "VO-08",
   "line": 2,
   "start": 91.823,
   "end": 93.799,
   "text": "资料证明不了"
  },
  {
   "vo": "VO-08",
   "line": 3,
   "start": 93.799,
   "end": 97.877,
   "text": "它不替人答应 留给接待方确认"
  },
  {
   "vo": "VO-08b",
   "line": 1,
   "start": 98.542,
   "end": 102.126,
   "text": "没有现成的讲解词也不要紧"
  },
  {
   "vo": "VO-08b",
   "line": 2,
   "start": 102.126,
   "end": 105.724,
   "text": "说清讲给谁 讲多久"
  },
  {
   "vo": "VO-08b",
   "line": 3,
   "start": 105.724,
   "end": 108.596,
   "text": "它只照着资料先写一版"
  },
  {
   "vo": "VO-08b",
   "line": 4,
   "start": 108.596,
   "end": 110.262,
   "text": "再逐句核对"
  },
  {
   "vo": "VO-09",
   "line": 1,
   "start": 112.842,
   "end": 114.384,
   "text": "同一项剪纸"
  },
  {
   "vo": "VO-09",
   "line": 2,
   "start": 114.384,
   "end": 118.758,
   "text": "来的人不一样 讲法也该不一样"
  },
  {
   "vo": "VO-10",
   "line": 1,
   "start": 119.492,
   "end": 121.302,
   "text": "换成一群中学生"
  },
  {
   "vo": "VO-10",
   "line": 2,
   "start": 121.302,
   "end": 123.494,
   "text": "多了一个观察环节"
  },
  {
   "vo": "VO-10",
   "line": 3,
   "start": 123.494,
   "end": 127.472,
   "text": "手作从 50 分钟 变成 80 分钟"
  },
  {
   "vo": "VO-11",
   "line": 1,
   "start": 129.474,
   "end": 133.29,
   "text": "讲解也换成学生听得懂的话"
  },
  {
   "vo": "VO-11",
   "line": 2,
   "start": 133.29,
   "end": 137.588,
   "text": "这 874 元里 584 元"
  },
  {
   "vo": "VO-11",
   "line": 3,
   "start": 137.588,
   "end": 141.202,
   "text": "付给本地讲解和手作老师"
  },
  {
   "vo": "VO-12",
   "line": 1,
   "start": 142.869,
   "end": 144.373,
   "text": "做不到的事"
  },
  {
   "vo": "VO-12",
   "line": 2,
   "start": 144.373,
   "end": 147.963,
   "text": "比如临时加一场英语讲解"
  },
  {
   "vo": "VO-12",
   "line": 3,
   "start": 147.963,
   "end": 151.153,
   "text": "它会停下来 先问人"
  },
  {
   "vo": "VO-13",
   "line": 1,
   "start": 152.582,
   "end": 156.862,
   "text": "手艺人的作品 一直在推陈出新"
  },
  {
   "vo": "VO-14",
   "line": 1,
   "start": 158.132,
   "end": 159.512,
   "text": "新作一发布"
  },
  {
   "vo": "VO-14",
   "line": 2,
   "start": 159.512,
   "end": 163.582,
   "text": "手册里用到旧作的地方 都被找了出来"
  },
  {
   "vo": "VO-15",
   "line": 1,
   "start": 165.796,
   "end": 168.526,
   "text": "重新核验 经人确认"
  },
  {
   "vo": "VO-15",
   "line": 2,
   "start": 168.526,
   "end": 171.136,
   "text": "新手册换上了新作品"
  },
  {
   "vo": "VO-15",
   "line": 3,
   "start": 171.136,
   "end": 174.062,
   "text": "拍板的 始终是人"
  },
  {
   "vo": "VO-15b",
   "line": 1,
   "start": 176.492,
   "end": 178.032,
   "text": "游客看完体验"
  },
  {
   "vo": "VO-15b",
   "line": 2,
   "start": 178.032,
   "end": 182.652,
   "text": "还能把喜欢的作品 从手艺人手里带回家"
  },
  {
   "vo": "VO-16",
   "line": 1,
   "start": 183.692,
   "end": 187.432,
   "text": "这一切 装在一台普通电脑里"
  },
  {
   "vo": "VO-16",
   "line": 2,
   "start": 187.432,
   "end": 192.122,
   "text": "离线运行 不花一分钱模型调用费"
  },
  {
   "vo": "VO-17",
   "line": 1,
   "start": 193.192,
   "end": 194.912,
   "text": "AI 正在成为人们"
  },
  {
   "vo": "VO-17",
   "line": 2,
   "start": 194.912,
   "end": 198.834,
   "text": "认识一个地方的第一扇窗"
  },
  {
   "vo": "VO-17",
   "line": 3,
   "start": 198.834,
   "end": 202.016,
   "text": "我们让它只讲有出处的话"
  },
  {
   "vo": "VO-17",
   "line": 4,
   "start": 202.016,
   "end": 206.284,
   "text": "把拍板权和收益 留在乡里"
  }
 ],
